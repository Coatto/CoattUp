<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoattUp"
        Icon="{DynamicResource W11Icon}"
        Background="#DCE5DA"
        Width="1040" Height="740"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowRootStyle}">
    <!-- Pennelli di stato risolti anche lato codice via FindResource (finestra = scope radice,
         indipendenti dal merge di styles.xaml). Logo Windows 11 (Start) vettoriale: 4 riquadri
         blu con gradiente azzurro, su sfondo trasparente (usabile su header e come icona). -->
    <Window.Resources>
        <SolidColorBrush x:Key="StatusActiveBrush"   Color="#6F8F6E"/>
        <SolidColorBrush x:Key="StatusInactiveBrush" Color="#BE6A52"/>
        <SolidColorBrush x:Key="StatusUnknownBrush"  Color="#B7A88F"/>
        <LinearGradientBrush x:Key="W11SquareBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0078D4" Offset="0"/>
            <GradientStop Color="#3B9EE8" Offset="1"/>
        </LinearGradientBrush>
        <DrawingImage x:Key="W11Icon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource W11SquareBrush}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="1,1,10,10" RadiusX="2.2" RadiusY="2.2"/>
                                <RectangleGeometry Rect="13,1,10,10" RadiusX="2.2" RadiusY="2.2"/>
                                <RectangleGeometry Rect="1,13,10,10" RadiusX="2.2" RadiusY="2.2"/>
                                <RectangleGeometry Rect="13,13,10,10" RadiusX="2.2" RadiusY="2.2"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>
    <Grid Background="#DCE5DA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intestazione: icona W11 + nome + riquadro compatto "Cambia DNS" -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,12">
                    <Image Source="{StaticResource W11Icon}" Width="30" Height="30"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="CoattUp" Style="{DynamicResource HeaderTitleStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- "Hz Schermo" + "Risparmio energia" + riquadro "Cambia DNS" (affiancati) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,8,16,8">
                    <!-- Schermo: apre la pagina Schermo delle Impostazioni -->
                    <Button x:Name="BtnHz" Content="Schermo" Padding="12,4"
                            Style="{DynamicResource SecondaryButtonStyle}" FontSize="12"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="Apre le impostazioni dello schermo"/>
                    <!-- Risparmio energia: apre il pannello classico dei piani di alimentazione -->
                    <Button x:Name="BtnPower" Content="Risparmio energia" Padding="12,4"
                            Style="{DynamicResource SecondaryButtonStyle}" FontSize="12"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="Apre le Opzioni risparmio energia (piani di alimentazione)"/>
                    <!-- Riquadro "Cambia DNS": apre le impostazioni rete (nessuna modifica automatica) -->
                    <Border Padding="14,7"
                            Background="#F2EDE4" BorderBrush="#C7D3C2" BorderThickness="1"
                            CornerRadius="8" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Cambia DNS" Style="{DynamicResource PanelHeaderStyle}"
                                       FontSize="13" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnDnsEthernet" Content="Ethernet" Padding="12,4"
                                        Style="{DynamicResource SecondaryButtonStyle}" FontSize="12"
                                        Margin="0,0,6,0"
                                        ToolTip="Apre le impostazioni di rete Ethernet"/>
                                <Button x:Name="BtnDnsWifi" Content="Wi-Fi" Padding="12,4"
                                        Style="{DynamicResource SecondaryButtonStyle}" FontSize="12"
                                        ToolTip="Apre le impostazioni di rete Wi-Fi"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Area principale -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Sinistra: checklist per categoria -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,7,0"
                    Background="#F2EDE4" BorderBrush="#C7D3C2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tweak disponibili"
                               Style="{DynamicResource PanelHeaderStyle}"/>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,10,0,10"
                             Style="{DynamicResource SearchBoxStyle}"
                             ToolTip="Filtra i tweak per nome o descrizione"/>
                    <TreeView x:Name="TweakTree"
                              Background="#D5E0D2"
                              BorderBrush="#C7D3C2"
                              BorderThickness="0"
                              Padding="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <!-- Destra: pannello dettaglio -->
            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="7,0,0,0"
                    Background="#F2EDE4" BorderBrush="#C7D3C2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Segnaposto quando nulla è selezionato -->
                        <TextBlock x:Name="DetailPlaceholder"
                                   Text="Seleziona un tweak a sinistra per vederne i dettagli."
                                   Style="{DynamicResource DetailValueStyle}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,8,0,0"/>

                        <!-- Contenuto del dettaglio -->
                        <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                            <TextBlock x:Name="DetailTitle" Style="{DynamicResource PageTitleStyle}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Categoria" Style="{DynamicResource DetailLabelStyle}" Margin="0,6,0,6"/>
                                <TextBlock x:Name="DetailCategory" Grid.Row="0" Grid.Column="1" Style="{DynamicResource DetailValueStyle}" Margin="0,6,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rischio" Style="{DynamicResource DetailLabelStyle}" Margin="0,6,0,6"/>
                                <TextBlock x:Name="DetailRisk" Grid.Row="1" Grid.Column="1" Style="{DynamicResource DetailValueStyle}" Margin="0,6,0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ambito" Style="{DynamicResource DetailLabelStyle}" Margin="0,6,0,6"/>
                                <TextBlock x:Name="DetailScope" Grid.Row="2" Grid.Column="1" Style="{DynamicResource DetailValueStyle}" Margin="0,6,0,6"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Riavvio" Style="{DynamicResource DetailLabelStyle}" Margin="0,6,0,6"/>
                                <TextBlock x:Name="DetailRestart" Grid.Row="3" Grid.Column="1" Style="{DynamicResource DetailValueStyle}" Margin="0,6,0,6"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Amministratore" Style="{DynamicResource DetailLabelStyle}" Margin="0,6,0,6"/>
                                <TextBlock x:Name="DetailAdmin" Grid.Row="4" Grid.Column="1" Style="{DynamicResource DetailValueStyle}" Margin="0,6,0,6"/>
                            </Grid>

                            <Separator Margin="0,14,0,10"/>

                            <TextBlock Text="Avvisi" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock x:Name="DetailWarnings" Style="{DynamicResource DetailValueStyle}"
                                       Foreground="{DynamicResource MediumRiskBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,12"/>

                            <TextBlock Text="Descrizione" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock x:Name="DetailDescription" Style="{DynamicResource DetailValueStyle}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Pannello risultati (verifica / applicazione) -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="14,0,14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Risultati"
                           Style="{DynamicResource PanelHeaderStyle}" Margin="0,0,0,6"/>
                <TextBox x:Name="ResultsBox" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" Height="56"
                         BorderThickness="1" BorderBrush="#C7D3C2"
                         Background="#EDE6DA" Foreground="#33402F" Padding="8,6" FontFamily="Consolas" FontSize="11"/>
            </DockPanel>
        </Border>

        <!-- Barra azioni + stato -->
        <Grid Grid.Row="3" Background="{DynamicResource HeaderBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,10">
                <Button x:Name="BtnApply" Content="Applica selezione" IsEnabled="False"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
                <Button x:Name="BtnUndo" Content="Annulla" IsEnabled="False"
                        Style="{DynamicResource DangerButtonStyle}" Margin="8,0,0,0"/>
                <Button x:Name="BtnDebloat" Content="Debloat app"
                        Style="{DynamicResource SecondaryButtonStyle}" Margin="8,0,0,0"
                        ToolTip="Apre le impostazioni per disinstallare le app installate a mano"/>
                <TextBlock Text="Barra di ricerca:" VerticalAlignment="Center"
                           Margin="18,0,6,0"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <ComboBox x:Name="SearchModeCombo" Width="190" VerticalAlignment="Center"
                          Style="{DynamicResource ComboStyle}"
                          ToolTip="Scegli la modalità della barra di ricerca"/>
                <Button x:Name="BtnActivate" Content="Attiva Windows"
                        Style="{DynamicResource ActivateButtonStyle}" Margin="16,0,0,0"
                        ToolTip="Apre il tool di attivazione di Microsoft Activation Scripts (Massgrave) in una finestra separata"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="SelectionCount" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="2" x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="18,10"/>
        </Grid>
    </Grid>
</Window>
